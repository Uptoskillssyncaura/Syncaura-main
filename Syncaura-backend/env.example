# Server Configuration
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_ACCESS_EXPIRES=21
JWT_REFRESH_EXPIRES=12

# Reset password
RESET_TOKEN_SECRET=your_reset_token_secret_here
RESET_TOKEN_EXPIRES_MIN=15

# Email (Ethereal for dev)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_ethereal_username
EMAIL_PASS=your_ethereal_password
EMAIL_FROM=your_ethereal_email@example.com

# Client
CLIENT_URL=https://flowbit.pages.dev
# Comma-separated list of allowed frontend origins (production)
ALLOWED_CLIENT_ORIGINS=https://flowbit.pages.dev,https://syncaura-main-rust.vercel.app

# Google OAuth (Login flow)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Login callback — must match Google Cloud Console authorized redirect URI exactly
GOOGLE_REDIRECT_URI=https://syncaura-main.onrender.com/api/auth/google/callback
# Calendar connect callback — separate from login
GOOGLE_CALENDAR_REDIRECT_URI=https://syncaura-main.onrender.com/auth/callback


# Slack Bot Configuration
SLACK_BOT_TOKEN=dummyslackbottoken
SLACK_SIGNING_SECRET=dummyslacksigningsecret
SLACK_APP_TOKEN=dummyslackapptoken


# GitHub API Configuration (optional)
GITHUB_CLIENT_ID=dummygithubclientid
GITHUB_CLIENT_SECRET=dummygithubclientsecret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback
CLIENT_URL=http://localhost:3000

# Google Calendar 
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account.json


#DATABASE
DATABASE_URL=postgresql://admin123@db.localhost:5432/Syncaura
