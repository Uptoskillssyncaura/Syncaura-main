# Server Configuration
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Reset password
RESET_TOKEN_SECRET=your_reset_token_secret_here
RESET_TOKEN_EXPIRES_MIN=15

# Email (Ethereal for dev)
EMAIL_ENABLED=true
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_ethereal_username
EMAIL_PASS=your_ethereal_password
EMAIL_FROM=your_ethereal_email@example.com

# Client
CLIENT_URL=http://localhost:5173

# Slack Bot Configuration
SLACK_BOT_TOKEN=dummyslackbottoken
SLACK_SIGNING_SECRET=dummyslacksigningsecret
SLACK_APP_TOKEN=dummyslackapptoken

# GitHub API Configuration (optional)
GITHUB_CLIENT_ID=dummygithubclientid
GITHUB_CLIENT_SECRET=dummygithubclientsecret

# Google Calendar
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_ID=pleaseEnter
GOOGLE_CLIENT_SECRET=pleaseenter
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DATABASE_URL=postgresql://your_database_user:your_database_password@localhost:5432/your_database_name
# AI Chatbot Integration (ollama or gemini)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
GEMINI_API_KEY=your_gemini_api_key_here


OFFICE_LATITUDE=
OFFICE_LONGITUDE=
OFFICE_RADIUS_METERS=150